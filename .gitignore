# Python cache and build artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter checkpoints
.ipynb_checkpoints/

# Editor and local tool state
.vscode/
.idea/
.cursor/
AGENTS.md
*.sublime-workspace
*.sublime-project

# Local secrets and credentials
.env
.env.*
*.key
*.token
*.secret
*.pem
credentials*
secrets*

# OS files
.DS_Store
._*
Thumbs.db

# Logs and temporary files
*.log
*.bak
*.swp
*.tmp
*.temp

# Generated experiment outputs and large local artifacts
output/**
!output/
!output/README.md
!output/.gitkeep
outputs/**
!outputs/
!outputs/README.md
!outputs/.gitkeep
resultsForData/
forFigures/
forVideo/
tmp/

# Disposable outputs produced by the independent README demo commands.
demo_runs/**
!demo_runs/
!demo_runs/.gitkeep

# Legacy preprocessed/generated data directories
initialFields/**
!initialFields/
!initialFields/README.md
!initialFields/.gitkeep

# Unified per-model data flow. Keep only the directory structure in Git.
model_data/**
!model_data/
!model_data/*/
!model_data/*/.gitkeep

# Model checkpoints and tensor/data caches
*.pth
*.pt
*.ckpt
*.npz
*.npy
*.h5
*.hdf5
*.pkl

# Mesh, point-cloud, visualization, and plot outputs
*.vtk
*.vtp
*.ply
*.png
*.jpg
*.jpeg
*.tif
*.tiff
*.gif
*.csv
*.svg

# STL files are usually large/generated.
*.stl

# Track the public bracket demo input in the unified model-data layout.
!model_data/target_shapes/bracket.stl

# Track the author-provided preprocessed bracket model used by later demos.
!model_data/preprocessed/bracket/
!model_data/preprocessed/bracket/bracket_support.stl

# Track the author-provided bracket implicit representations.
!model_data/implicit_representations/bracket/
!model_data/implicit_representations/bracket/bracket_voxel_implicit.pt
!model_data/implicit_representations/bracket/bracket_siren_sdf.pt

# Track the author-provided bracket voxelization and initial-field results.
!model_data/initial_fields/bracket/
!model_data/initial_fields/bracket/bracket_res100_voxels.txt
!model_data/initial_fields/bracket/bracket_res100_centers.txt
!model_data/initial_fields/bracket/bracket_res100_initial_fields.txt

# Keep placeholder docs in legacy/default data directories.
!stlFiles/
!stlFiles/README.md
!stlFiles/.gitkeep

# Allow examples and documentation assets.
!examples/
!examples/**
!assets/
!assets/**

# Allow common example/documentation asset formats inside curated public folders.
!examples/**/*.stl
!examples/**/*.pt
!examples/**/*.pth
!examples/**/*.json
!examples/**/*.txt
!examples/**/*.md
!assets/**/*.png
!assets/**/*.jpg
!assets/**/*.jpeg
!assets/**/*.svg
!assets/**/*.gif

# Keep repository metadata and docs trackable.
!.gitignore
!README.md
!requirements.txt
